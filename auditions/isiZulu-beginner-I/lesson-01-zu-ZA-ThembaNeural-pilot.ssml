  <!-- zulu-beginner-01-core beat 4; role assignment PROVISIONAL_ROLE_MUST_VERIFY -->
  <voice name="zu-ZA-ThembaNeural"><prosody rate="-12%">Ngiyaphila, wena unjani?</prosody></voice>
  <break time="700ms"/>
  <!-- zulu-beginner-01-core beat 6; role assignment PROVISIONAL_ROLE_MUST_VERIFY -->
  <voice name="zu-ZA-ThembaNeural"><prosody rate="-12%">Ngiyabonga, ngiyaphila. Sala kahle.</prosody></voice>
  <break time="700ms"/>
  <!-- zulu-beginner-01-core beat 8; role assignment PROVISIONAL_ROLE_MUST_VERIFY -->
  <voice name="zu-ZA-ThembaNeural"><prosody rate="-12%">Sanibonani</prosody></voice>
  <break time="700ms"/>
