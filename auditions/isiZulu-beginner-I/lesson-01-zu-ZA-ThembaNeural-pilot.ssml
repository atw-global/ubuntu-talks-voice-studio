  <!-- zulu-beginner-01-sounds beat 6; role assignment PROVISIONAL_ROLE_MUST_VERIFY -->
  <voice name="zu-ZA-ThembaNeural"><prosody rate="-12%">amawele</prosody></voice>
  <break time="700ms"/>
  <!-- zulu-beginner-01-sounds beat 8; role assignment PROVISIONAL_ROLE_MUST_VERIFY -->
  <voice name="zu-ZA-ThembaNeural"><prosody rate="-12%">qamba</prosody></voice>
