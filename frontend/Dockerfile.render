# Render-only static preview: no GPU or OpenSpeakers API provisioned
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
RUN apk add --no-cache apache2-utils
COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.render.conf /etc/nginx/conf.d/default.conf
COPY entrypoint.render.sh /usr/local/bin/ubuntu-studio-start
RUN chmod +x /usr/local/bin/ubuntu-studio-start
EXPOSE 10000
CMD ["/usr/local/bin/ubuntu-studio-start"]
