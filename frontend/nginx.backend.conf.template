# Used only when both Render backend URL and gateway token are configured.
server {
    listen 10000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    auth_basic "Ubuntu Talks Voice Studio";
    auth_basic_user_file /etc/nginx/.voice-studio-htpasswd;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location /api/ {
        proxy_pass ${STUDIO_BACKEND_URL};
        proxy_set_header Host ${STUDIO_BACKEND_HOST};
        proxy_ssl_server_name on;
        proxy_set_header X-Voice-Studio-Internal-Key "${STUDIO_BACKEND_GATEWAY_TOKEN}";
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 180s;
    }

    location /ws/ {
        proxy_pass ${STUDIO_BACKEND_URL};
        proxy_set_header Host ${STUDIO_BACKEND_HOST};
        proxy_ssl_server_name on;
        proxy_set_header X-Voice-Studio-Internal-Key "${STUDIO_BACKEND_GATEWAY_TOKEN}";
        proxy_set_header Authorization "";
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
